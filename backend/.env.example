# Environnement : development, test ou production
APP_ENV=development

# Utiliser une valeur longue et aléatoire. Ne jamais la committer.
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters

# Base locale de développement
MONGO_URL=mongodb://localhost:27017
DB_NAME=apa_connect_dev

# Nouveau socle PostgreSQL, ajoute en parallele. Il reste desactive tant que
# les migrations et tests de comparaison ne sont pas valides.
SQL_BACKEND_ENABLED=false
SQL_DATABASE_URL=postgresql+psycopg://apa_connect:local-only@localhost:5432/apa_connect_dev

# Liste séparée par des virgules, sans joker.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# En local avec deux services HTTP sur localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Désactivé par défaut. À réserver à la création initiale d'un environnement.
ENABLE_ADMIN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Données entièrement fictives, interdites dans APP_ENV=production.
ENABLE_DEMO_SEED=false

# Envoi des liens de reinitialisation. Conserver desactive tant qu'un service
# email securise n'est pas configure. Ne jamais committer SMTP_PASSWORD.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# En production, utiliser au minimum :
# APP_ENV=production
# CORS_ALLOWED_ORIGINS=https://apaconnect.fr,https://www.apaconnect.fr
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# ENABLE_ADMIN_SEED=false
# ENABLE_DEMO_SEED=false
# EMAIL_DELIVERY_ENABLED=true
# FRONTEND_URL=https://apaconnect.fr
