# Environnement : development, test ou production
APP_ENV=development

# Utiliser une valeur longue et aléatoire. Ne jamais la committer.
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters

# Base locale de développement
MONGO_URL=mongodb://localhost:27017
DB_NAME=apa_connect_dev

# Liste séparée par des virgules, sans joker.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# En local avec deux services HTTP sur localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Désactivé par défaut. À réserver à la création initiale d'un environnement.
ENABLE_ADMIN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Données entièrement fictives, interdites dans APP_ENV=production.
ENABLE_DEMO_SEED=false
